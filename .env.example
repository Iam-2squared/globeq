# Server only. Use a PostgreSQL transaction pooler URL for serverless deployment.
DATABASE_URL=postgresql://username:password@localhost:5432/globeq
# Only for operator scripts. Not exposed to browser or stored in repository.
EDITOR_USER_ID=

# Server-only OpenAI key for private draft generation. Never expose to browser.
OPENAI_API_KEY=
# Optional; defaults to gpt-5-mini.
OPENAI_DRAFT_MODEL=gpt-5-mini
